Table users {
  User_ID integer [pk]
  customer integer [ref: > customers.customer_id]
  name varchar(255)
  last_name varchar(255)
  teacher integer
  departement integer [ref: > departements.department_id  ]
  karten_nummer varchar(255)
  permission varchar(255)
}

Table user_settings {
  setting_id integer [pk]
  customer integer [ref: > customers.customer_id]
  notification_method varchar(100)
  notify_url varchar(150)
  dveria_key varchar(250)
  dveria_ric varchar(150)
  User_ID integer [ref: - users.User_ID]
}


Table teachers {
  teacher_id integer [pk]
  customer integer [ref: > customers.customer_id]
  first_name varchar(255)
  last_name varchar(255)
  house varchar(255)
}

Table departements {
  department_id integer [pk]
  customer integer [ref: > customers.customer_id]
  departement_name varchar(255)
  is_active boolean
  location int  [ref: > locations.location_id]
}

Table locations{
  location_id integer [pk]
  customer integer [ref: > customers.customer_id]
  name varchar(255)
  symbol varchar(10)
  is_active bool
}

Table alarmierungen {
  alert_id integer [pk]
  customer integer [ref: > customers.customer_id]
  alert_received timestamp
  alert_type varchar(255)
  symptom varchar(255)
}

Table patient {
  id integer [pk]
  customer integer [ref: > customers.customer_id]
  real_name text
  real_last_name text
  birth_day text
  created_at timestamp
  pseudonym varchar(255) [unique]
}

Table protokolle {
  protokoll_id integer [pk]
  customer integer [ref: > customers.customer_id]
  alert_id integer [ref: - alarmierungen.alert_id]
  pseudonym varchar(255) [ref: > patient.pseudonym]
  teacher_id integer [ref: > teachers.teacher_id]

  operation_end timestamp
  status varchar(255)
  pulse integer
  spo2 integer
  blood_pressure varchar(255)
  temperature integer
  blood_sugar integer
  pain varchar(255)

  measures text
  abhol_massnahme varchar(255)
  parents_notified_by varchar(255)
  parents_notified_at timestamp
  hospital varchar(255)
  medic_id integer
}

Table sani_protokoll {
  sani_protokoll_id integer [pk]
  customer integer [ref: > customers.customer_id]
  sani1 integer [ref: > users.User_ID]
  sani2 integer [ref: > users.User_ID]
  operationsmanager integer [ref: > users.User_ID]
  protokoll_id integer [ref: > protokolle.protokoll_id]
}

Table materials {
  material_id integer [pk]
  customer integer [ref: > customers.customer_id]
  material_name varchar(255)
  material_barcode varchar(255)
  barcode_type varchar(50)
  quantity integer
  expires_at timestamp
  minimum_stock integer
}

Table protokoll_materials {
  material_protokoll_id integer [pk]
  customer integer [ref: > customers.customer_id]
  protokoll_id integer [ref: - protokolle.protokoll_id]
  material_id integer [ref: > materials.material_id]
  quantity integer
}
Table customers{
  customer_id int [pk]
  customer_number varchar(100) [unique]
  contact_person_first_name varchar(255)
  contact_person_last_name varchar(255)
  email varchar(100)
  phone_number varchar(100)
}




Table customer_key_slots {
  slot_id       integer [pk]
  customer_id   integer [ref: > customers.customer_id]
  user_id       integer [ref: - users.User_ID]
  encrypted_gek text
  created_at    timestamp
}

Table user_keys {
  key_id                integer [pk]
  user_id               integer [ref: - users.User_ID]
  public_key            text
  encrypted_private_key text
  argon2_salt           text
  created_at            timestamp
  is_active             boolean
}

